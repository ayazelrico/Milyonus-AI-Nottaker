        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyonus Nottaker, kaydetmeyi seçtiğiniz toplantıları yazıya dökmek için mikrofon erişimine ihtiyaç duyar."
          }
        }
      }
    }
  },
  "version": "1.0"
